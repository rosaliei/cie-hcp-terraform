$ terraform output -raw fe_private_key_openssh > frontend-ssh-key.pem && chmod 400 frontend-ssh-key.pem
$ ls -la frontend-ssh-key.pem
-r--------@ 1 k.sithi  staff  387 Oct 23 15:41 frontend-ssh-key.pem
$ head -1 frontend-ssh-key.pem
-----BEGIN OPENSSH PRIVATE KEY-----
$ git check-ignore -v frontend-ssh-key.pem
.gitignore:18:*-ssh-key.pem	frontend-ssh-key.pem

$ ssh -i frontend-ssh-key.pem ec2-user@<public-ip> "hostname; whoami; uptime"
