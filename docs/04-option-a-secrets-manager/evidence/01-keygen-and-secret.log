+----------------------------+----------------------------------------+
|            Name            |               VersionId                |
+----------------------------+----------------------------------------+
|  /frontend/ssh/private-key |  ee7af2f0-80b2-405f-992e-e8eb865f12ae  |
+----------------------------+----------------------------------------+

$ cat frontend-key-a.pub     # public half -> HCP workspace variable fe_public_key (not sensitive)
ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIOrbmb6I/yFVfgrP0Ft2Db7z7ZwBMvsz+lb5ry1w+6tw frontend-option-a
