$ ssh-keygen -t ed25519 -N "" -C "frontend-option-a" -f frontend-key-a
-rw-------@ 411 frontend-key-a
-rw-r--r--@ 99 frontend-key-a.pub

$ aws secretsmanager create-secret --name /frontend/ssh/private-key --secret-string file://frontend-key-a
